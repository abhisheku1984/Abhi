# ============================================================
# Abhi Studio — environment template
# Copy to .env and fill what you have. NOTHING is required to boot:
# the app starts with LOCAL/DEMO engines and reports missing
# providers as `not_configured` instead of failing.
# ============================================================

# ---- server ----
ABHI_HOST=0.0.0.0
ABHI_PORT=8000
ABHI_DATA_DIR=./data
ABHI_LOG_LEVEL=INFO
# Comma separated origins allowed to call the API from a browser.
# The built SPA is served from this same origin, so leave empty for single-port use.
ABHI_CORS_ORIGINS=

# ---- auth ----
ABHI_ADMIN_USER=admin
# CHANGE THIS. If left empty a random password is generated and printed once at first boot.
ABHI_ADMIN_PASSWORD=abhi-admin
ABHI_SESSION_TTL_HOURS=720

# ---- default provider routing (auto = best available, falls back to local engines) ----
ABHI_IMAGE_PROVIDER=auto
ABHI_VIDEO_PROVIDER=auto
ABHI_TTS_PROVIDER=auto
ABHI_LLM_PROVIDER=auto
ABHI_LIPSYNC_PROVIDER=auto

# ---- cloud providers (optional; each unlocks one capability) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_LLM_MODEL=gpt-4o-mini

STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai

REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1

RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

ANTHROPIC_API_KEY=

# ---- local / self-hosted GPU hosts (optional) ----
# ComfyUI reachable on your GPU machine, e.g. http://192.168.1.50:8188
ABHI_COMFYUI_URL=
ABHI_COMFYUI_TOKEN=
# Automatic1111 / Forge, e.g. http://192.168.1.50:7860
ABHI_A1111_URL=
ABHI_A1111_TOKEN=
# Ollama for local text models, e.g. http://localhost:11434
ABHI_OLLAMA_URL=
ABHI_OLLAMA_MODEL=llama3.1
# Local Wav2Lip / SadTalker checkout for lip sync on a GPU host
ABHI_WAV2LIP_DIR=
ABHI_SADTALKER_DIR=
# Optional explicit ffmpeg binary (defaults to the bundled static build)
ABHI_FFMPEG_BIN=
