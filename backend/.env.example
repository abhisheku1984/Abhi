# ---------------------------------------------------------------------
# AI Creative Studio — backend configuration
# Copy to backend/.env and edit. Nothing here is hard-coded in the source:
# every value below is read from the environment at startup (§42.7).
# ---------------------------------------------------------------------

# ---- application -----------------------------------------------------
APP_NAME="AI Creative Studio"
APP_ENV=development          # development | staging | production | test
DEBUG=false
API_PREFIX=/api
API_VERSION=v1

# ---- database (SQLite by default; PostgreSQL by URL) ------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/studio.db
# PostgreSQL (recommended for multi-user / production):
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- queue ------------------------------------------------------------
# auto = Redis when REDIS_URL is set, otherwise the database queue.
QUEUE_BACKEND=auto
REDIS_URL=

# ---- storage ----------------------------------------------------------
# local  -> files under backend/storage
# s3     -> any S3-compatible bucket (MinIO, R2, AWS)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- security ---------------------------------------------------------
# CHANGE THIS before exposing the server. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=20160
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_PER_MINUTE=600
MAX_UPLOAD_MB=512
CORS_ORIGINS=*
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/webp,image/gif,image/bmp,image/tiff,video/mp4,video/webm,video/quicktime,video/x-msvideo,audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/flac,audio/mp4,audio/aac

# ---- jobs -------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=0.4
JOB_DEFAULT_TIMEOUT_SECONDS=3600
JOB_MAX_ATTEMPTS=3
ENABLE_BACKGROUND_WORKER=true

# ---- media ------------------------------------------------------------
# Leave empty to auto-detect: PATH ffmpeg → bundled imageio-ffmpeg binary.
FFMPEG_BINARY=
FFPROBE_BINARY=

# ---- gpu --------------------------------------------------------------
GPU_ENABLED=true
GPU_REMOTE_AGENT_URL=

# ---- safety & rights --------------------------------------------------
SAFETY_ENABLED=true
SAFETY_BLOCKLIST=
REQUIRE_VOICE_CLONE_ATTESTATION=true
WATERMARK_ENABLED=false
WATERMARK_TEXT="AI Creative Studio"

# ---- engines ----------------------------------------------------------
# Comma-separated adapter ids to allow (blank = all registered adapters).
ENGINE_ALLOWLIST=
# §32/§43 — weights are NEVER downloaded automatically. Keep this false.
AUTO_DOWNLOAD_MODELS=false

# ---- first run --------------------------------------------------------
# Used only to create the very first owner account. Change after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@studio.ai
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME="Studio Admin"

# =====================================================================
# Provider credentials — all optional (§34: keys live in env, never the UI)
# Without these the adapter reports "Provider not configured".
# NOTE: leave the value empty when unused — do NOT add comments after the
# '=' (they would become part of the value).
# =====================================================================
# e.g. https://api.openai.com/v1
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
# e.g. gpt-image-1, dall-e-3
IMAGE_API_MODEL=

VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_MODEL=

TTS_API_BASE_URL=
TTS_API_KEY=
TTS_API_MODEL=

AUDIO_API_BASE_URL=
AUDIO_API_KEY=

AVATAR_API_BASE_URL=
AVATAR_API_KEY=

# Local neural models (Tier B) — local dir or HF repo id of weights you
# installed yourself (never downloaded without your explicit approval, §32).
DIFFUSERS_IMAGE_MODEL=
DIFFUSERS_VIDEO_MODEL=
# e.g. coqui/XTTS-v2
VOICE_CLONE_MODEL=
# Wav2Lip checkpoint path
LIPSYNC_CHECKPOINT=
LIPSYNC_RUNNER=
